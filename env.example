# ============================================
# Sahahly OS - Environment Variables
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# مفتاح الخدمة: يُستخدم في السيرفر فقط ولا يُكشف للمتصفح أبدًا
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp Provider ---
# القيم المتاحة: ultramsg | cloud_api
WHATSAPP_PROVIDER=ultramsg

# UltraMsg
ULTRAMSG_INSTANCE_ID=your-ultramsg-instance-id
ULTRAMSG_TOKEN=your-ultramsg-token

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_CLOUD_ACCESS_TOKEN=your-cloud-api-access-token

# --- التطبيق ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# سر داخلي لحماية استدعاء مسارات الذكاء الاصطناعي بين الخدمات
INTERNAL_API_SECRET=change-this-to-a-long-random-string
